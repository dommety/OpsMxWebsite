{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opsmx-active-page",
  "compatibility_date": "2026-10-29",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
 "routes": [
  {
    "pattern": "opsmx.com/*",
    "zone_name": "opsmx.com"
  },
  {
    "pattern": "www.opsmx.com/*",
    "zone_name": "opsmx.com"
  }
],
  "workers_dev": true,
  "preview_urls": true
}
